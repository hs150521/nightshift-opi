# Nightshift MQTT ACL
# Used by all listeners (per_listener_settings applies auth per-listener).

# nightshift-opi (local backend): full access to the nightshift namespace
user nightshift-opi
topic readwrite nightshift/#

# pressure-01 (ESP32 pressure sensor): publish only the frozen device topics
user pressure-01
topic write nightshift/v1/sensor/pressure/pressure-01/availability
topic write nightshift/v1/sensor/pressure/pressure-01/state
topic write nightshift/v1/sensor/pressure/pressure-01/telemetry

# Development console: observe OPI state and command only this node.
user nightshift-console
topic read nightshift/v1/opi/opi3b01/availability
topic read nightshift/v1/opi/opi3b01/state
topic read nightshift/v1/opi/opi3b01/event
topic read nightshift/v1/opi/opi3b01/telemetry
topic write nightshift/v1/opi/opi3b01/command
topic read nightshift/v1/opi/opi3b01/reply/nightshift-console
