# Nightshift OPI environment configuration (example)
# Copy to /opt/nightshift-opi/.env and fill in secrets.

NIGHTSHIFT_NODE_ID=opi3b01
NIGHTSHIFT_DB_PATH=/var/lib/nightshift/nightshift.db

# UART to T5 display panel
NIGHTSHIFT_UART_DEVICE=/dev/ttyS3
NIGHTSHIFT_UART_BAUDRATE=460800
NIGHTSHIFT_UART_HEARTBEAT_SECONDS=2.0

# Pressure sensor configuration
NIGHTSHIFT_PRESSURE_CLIENT_ID=pressure-01
NIGHTSHIFT_PRESSURE_STALE_MS=10000
NIGHTSHIFT_PRESSURE_DWELL_MS=3000

# MQTT broker (Mosquitto on localhost, backend user)
NIGHTSHIFT_MQTT_ENABLED=true
NIGHTSHIFT_MQTT_HOST=127.0.0.1
NIGHTSHIFT_MQTT_PORT=1883
NIGHTSHIFT_MQTT_USERNAME=nightshift-opi
NIGHTSHIFT_MQTT_PASSWORD=SET_THIS_TO_THE_REAL_PASSWORD
NIGHTSHIFT_MQTT_BASE_TOPIC=nightshift/v1
NIGHTSHIFT_MQTT_KEEPALIVE=30
NIGHTSHIFT_MQTT_TLS_ENABLED=false
NIGHTSHIFT_MQTT_CA_FILE=
