[Unit]
Description=Nightshift AP (hostapd + dnsmasq on ap0)
Wants=netplan-wpa-wlan0.service network-online.target
After=sys-subsystem-net-devices-wlan0.device netplan-wpa-wlan0.service network-online.target
ConditionPathExists=/sys/class/net/wlan0
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/local/sbin/nightshift-ap-start
ExecStopPost=/usr/local/sbin/nightshift-ap-stop
Restart=on-failure
RestartSec=30
TimeoutStartSec=0
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target
