#!/bin/bash
# Stop only Nightshift-owned AP processes and remove the ap0 virtual interface.
set -u

for pid_file in /run/nightshift-dnsmasq.pid /run/nightshift-hostapd.pid; do
    if [ -f "$pid_file" ]; then
        pid="$(cat "$pid_file")"
        kill "$pid" 2>/dev/null || true
        rm -f "$pid_file"
    fi
done

if ip link show ap0 >/dev/null 2>&1; then
    ip link set ap0 down 2>/dev/null || true
    iw dev ap0 del 2>/dev/null || true
fi
