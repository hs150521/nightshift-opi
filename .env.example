# Nightshift Orange Pi 3B 2G configuration
NIGHTSHIFT_NODE_ID=opi3b01

# ---------------------------------------------------------------------------
# Pressure sensor (ESP32 pressure-01 over MQTT)
# ---------------------------------------------------------------------------
# The Opi3B no longer reads any GPIO directly. Pressure state arrives as
# retained MQTT messages under nightshift/v1/sensor/pressure/<client_id>/*
# from an ESP32 firmware that publishes `nightshift.pressure-state.v1`.
NIGHTSHIFT_PRESSURE_CLIENT_ID=pressure-01
# State is considered stale after this many ms without a fresh sample.
NIGHTSHIFT_PRESSURE_STALE_MS=10000
# All-released dwell before promoting to NIGHT_EXEC.
NIGHTSHIFT_PRESSURE_DWELL_MS=3000

# ---------------------------------------------------------------------------
# UART (T5-Link v1)
# ---------------------------------------------------------------------------
# Orange Pi 3B Pin 27/28/14 are wired to T5 P11 header (verified working).
# Pin 14 (GND)                 -> T5 P11 header GND
# Pin 28 (GPIO1_A0, UART3_TX)  -> T5 P11 header Pin 1 (T5 UART0_RX)
# Pin 27 (GPIO1_A1, UART3_RX)  -> T5 P11 header Pin 2 (T5 UART0_TX)
#
# UART7 is disabled in the device tree to free its pins (GPIO3_C4/C5) for the
# Ethernet MDIO interface. A custom overlay enables UART3-M0 and disables
# UART7; it is referenced in /boot/extlinux/extlinux.conf. Reboot for changes
# to take effect.
NIGHTSHIFT_UART_DEVICE=/dev/ttyS3
NIGHTSHIFT_UART_BAUDRATE=460800
NIGHTSHIFT_UART_HEARTBEAT_SECONDS=2

# ---------------------------------------------------------------------------
# MQTT external interface
# ---------------------------------------------------------------------------
# MQTT is the boundary for both pressure ingest and system-state publish.
# Production deployment sets this to true. false is only for isolated
# development without the ESP32 pressure node.
# The backend always connects to 127.0.0.1:1883 (loopback listener).
# A second listener on 192.168.51.1:1884 serves the ESP32 on ap0.
# Anonymous access is disabled on both listeners; credentials are required.
NIGHTSHIFT_MQTT_ENABLED=true
NIGHTSHIFT_MQTT_HOST=127.0.0.1
NIGHTSHIFT_MQTT_PORT=1883
NIGHTSHIFT_MQTT_USERNAME=nightshift-opi
NIGHTSHIFT_MQTT_PASSWORD=SET_THIS_TO_THE_REAL_PASSWORD
NIGHTSHIFT_MQTT_BASE_TOPIC=nightshift/v1
NIGHTSHIFT_MQTT_KEEPALIVE=30
NIGHTSHIFT_MQTT_TLS_ENABLED=false
NIGHTSHIFT_MQTT_CA_FILE=
